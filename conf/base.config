/*
 * Resource requests, keyed by process label rather than by process name.
 *
 * Labels are an indirection worth understanding: a process declares *what kind* of work it is
 * (`label 'process_high_memory'`), and the config decides what that means on this particular
 * machine. Add a new process and it inherits sane resources for free; move to an HPC cluster and you
 * change one config file, not fifteen modules.
 *
 * Two mechanisms are at work here:
 *
 *   `resourceLimits` clamps every request to what the hardware actually has. Older nf-core pipelines
 *   did this with a `check_max()` Groovy function defined in nextflow.config; Nextflow 24.04+ made it
 *   a first-class setting, which matters because the stricter config parser in recent versions does
 *   not allow function definitions in config files at all.
 *
 *   `task.attempt` scaling means a task killed by the OOM killer gets more memory on retry rather
 *   than failing the whole run. This is the single most useful reliability feature in Nextflow and
 *   costs one line per process.
 */

process {
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 2.h  * task.attempt }

    // Exit codes 130-145 and 104 are the signals a scheduler or the OOM killer sends. Retrying those
    // is worthwhile. Retrying a genuine python traceback (exit 1) is not: it will just fail again
    // more slowly, so we let it terminate the run immediately and show you the error.
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_low {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 4
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    // The 73k-cell reference is the memory ceiling of this pipeline. scRNA-seq QC, HVG selection and
    // Tangram mapping all land here.
    withLabel: process_high_memory {
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }
}
