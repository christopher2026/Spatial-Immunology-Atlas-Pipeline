/*
 * Spatial Immune Atlas Pipeline - top-level configuration
 *
 * Layering, in order of increasing specificity (later wins):
 *   1. params block below       - pipeline defaults, all overridable on the CLI with --<name>
 *   2. conf/base.config         - resource requests, keyed by process label
 *   3. conf/<profile>.config    - executor/container settings, activated with -profile
 *   4. CLI flags                - -profile, --param, -c extra.config
 *
 * That layering is the whole point of Nextflow config: the same main.nf runs on your laptop, in CI,
 * and on an HPC scheduler with no code change - only profile changes. Being able to articulate this
 * is a better answer to "why Nextflow" than reciting feature lists.
 */

params {
    // --- Input data -------------------------------------------------------------------
    // Populated by bin/fetch_data.py. Defaults assume the WSL data dir from setup/bootstrap_wsl.sh.
    sc_reference        = "${System.getenv('STPIPE_DATA') ?: './data'}/reference/sc.h5ad"
    visium_dir          = "${System.getenv('STPIPE_DATA') ?: './data'}/visium/V1_Human_Lymph_Node"
    sample_id           = 'V1_Human_Lymph_Node'

    // --- scRNA-seq QC (Phase 1) -------------------------------------------------------
    sc_min_genes        = 200      // drop cells with fewer detected genes: likely empty droplets / debris
    sc_min_cells        = 3        // drop genes seen in fewer cells: no statistical power, only noise
    sc_max_pct_mt       = 20       // high mitochondrial fraction indicates stressed or dying cells
    sc_run_scrublet     = true

    // --- scRNA-seq clustering (Phase 2) -----------------------------------------------
    sc_n_hvg            = 2000
    sc_n_pcs            = 50
    sc_n_neighbors      = 15
    sc_leiden_resolution = 1.0
    sc_celltype_key     = 'Subset'  // curated label column in the reference; VERIFY in Phase 1

    // --- Spatial QC + clustering (Phase 3) --------------------------------------------
    sp_min_counts       = 500      // per-spot total counts; spots below this are off-tissue or low quality
    sp_min_genes        = 200
    sp_n_hvg            = 2000
    sp_n_pcs            = 30
    sp_leiden_resolution = 1.0

    // --- Deconvolution (Phase 4) ------------------------------------------------------
    tangram_mode        = 'cells'   // 'cells' | 'clusters' - 'clusters' is much cheaper
    tangram_num_epochs  = 1000
    tangram_device      = 'cpu'
    tangram_density_prior = 'rna_count_based'

    // --- Spatial statistics (Phase 5) -------------------------------------------------
    nhood_n_perms       = 1000
    moran_n_perms       = 100
    run_ligrec          = false     // stretch goal; expensive

    // --- Output -----------------------------------------------------------------------
    outdir              = './results'
    publish_dir_mode    = 'copy'

    // --- Container image naming -------------------------------------------------------
    // Local builds by default. Switch to 'ghcr.io/<your-github-username>' in Phase 6 once images
    // are pushed, so CI and anyone cloning the repo can pull instead of rebuild.
    container_prefix    = 'stpipe'
    container_tag       = '0.1.0'

    // --- Misc -------------------------------------------------------------------------
    max_cpus            = 8
    // WSL currently exposes about 15.6 GB to Docker; leave headroom for the daemon and OS.
    max_memory          = '12.GB'
    max_time            = '8.h'
    help                = false
}

// Resource requests per process label.
includeConfig 'conf/base.config'

profiles {
    standard {
        // Local execution with whatever python is on PATH. Useful only for quick syntax checks;
        // real runs should use -profile docker so the environment is reproducible.
        process.executor = 'local'
        docker.enabled   = false
    }
    docker {
        includeConfig 'conf/docker.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
    debug {
        // Keep every task's work directory and echo commands, for post-mortem debugging.
        cleanup               = false
        process.beforeScript  = 'echo "--- host: $HOSTNAME  workdir: $PWD ---"'
        dumpHashes            = true
    }
}

// Nextflow's own run metadata. These four files are genuinely useful artifacts to show an
// interviewer: they demonstrate you can reason about pipeline performance, not just correctness.
// The DAG html in particular is the figure that goes in the README.
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html" }

manifest {
    name            = 'spatial-immune-atlas'
    author          = 'Chris'
    description     = 'Nextflow DSL2 pipeline integrating scRNA-seq and Visium spatial transcriptomics to spatially map immune cell types in human lymph node'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '0.1.0'
}

// NOTE on bin/: Nextflow automatically adds a `bin/` directory at the pipeline root to PATH inside
// every task and marks its contents executable. That is precisely why the nf-core convention puts
// analysis code there as argparse CLIs rather than inlining python in `script:` blocks - you get
// standalone runnability for free, with no packaging step.
