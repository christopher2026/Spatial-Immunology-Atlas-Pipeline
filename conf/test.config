/*
 * Test profile: the whole DAG on a subsampled dataset, in a few minutes.
 *
 *   nextflow run main.nf -profile test,docker
 *
 * This exists for three reasons, in order of importance:
 *   1. It is what CI runs, so every push proves the pipeline still executes end to end.
 *   2. It is what a stranger cloning your repo runs to verify it works, in one command.
 *   3. It is what you run after every refactor, because a 3-minute check you actually run beats a
 *      40-minute check you skip.
 *
 * Test data is generated by bin/make_test_data.py (Phase 6) and committed under assets/test_data/,
 * small enough to live in git so CI needs no external downloads.
 */

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal subsampled dataset to exercise the full DAG quickly'

    // Committed subsampled inputs: ~500 reference cells, ~200 Visium spots.
    sc_reference        = "${projectDir}/assets/test_data/sc_subsampled.h5ad"
    visium_dir          = "${projectDir}/assets/test_data/visium_subsampled"
    sample_id           = 'test_lymph_node'

    // Loosened QC thresholds. On 500 cells, production thresholds would filter almost everything and
    // the test would fail for reasons unrelated to the code being correct.
    sc_min_genes        = 50
    sc_min_cells        = 1
    sc_max_pct_mt       = 100
    sc_run_scrublet     = false     // scrublet needs a reasonable cell count to estimate a doublet rate

    sc_n_hvg            = 500
    sc_n_pcs            = 15
    sc_n_neighbors      = 10

    sp_min_counts       = 10
    sp_min_genes        = 10
    sp_n_hvg            = 500
    sp_n_pcs            = 10

    // The single biggest lever on test runtime.
    tangram_mode        = 'clusters'
    tangram_num_epochs  = 20

    nhood_n_perms       = 20
    moran_n_perms       = 10
    run_ligrec          = false

    max_cpus            = 2
    max_memory          = '6.GB'
    max_time            = '1.h'
}
