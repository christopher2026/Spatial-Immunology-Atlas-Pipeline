<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Spatial Immune Atlas — {{ sample.id }}</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem; color: #222; }
    h1, h2 { color: #111; }
    figure { margin: 1.5rem 0; }
    /* Change max-height to make plots larger or smaller. width: auto keeps aspect ratio. */
    figure img {
      display: block;
      max-width: 100%;
      max-height: 420px;
      width: auto;
      height: auto;
      border: 1px solid #ddd;
    }
    figcaption { margin-top: 0.4rem; font-size: 0.9rem; color: #444; }
    table { border-collapse: collapse; margin: 1rem 0; font-size: 0.95rem; }
    th, td { border: 1px solid #ccc; padding: 0.4rem 0.6rem; text-align: left; }
    .meta { color: #555; }
    .table-caption { text-align: left; font-weight: 600; margin: 0.6rem 0 0.4rem; }
    /* Only this box scrolls; the page stays put. */
    .table-scroll {
      max-width: 100%;
      max-height: 280px;
      overflow: auto;
      border: 1px solid #ccc;
      margin: 0 0 1.5rem;
    }
    .table-scroll table {
      margin: 0;
      white-space: nowrap;
    }
  </style>
</head>
<body>
  <h1>Spatial Immune Atlas</h1>
  <p class="meta">Sample <strong>{{ sample.id }}</strong>. This HTML file represents the results of the Nextflow/Docker pipeline.</p>

  <h2>Summary</h2>
  <table>
    <tbody>
      {% for key, value in sample.items() %}
      <tr><th>{{ key }}</th><td>{{ value }}</td></tr>
      {% endfor %}
    </tbody>
  </table>

  {% for section in sections %}
  <h2>{{ section.title }}</h2>
  <p>{{ section.description }}</p>
  {% for fig in section.figures %}
  <figure>
    <img src="{{ fig.b64 }}" alt="{{ fig.caption }}">
    <figcaption>{{ fig.caption }}</figcaption>
  </figure>
  {% endfor %}
  {% for table in section.tables %}
  <p class="table-caption">{{ table.caption }}</p>
  <div class="table-scroll">
    {{ table.html | safe }}
  </div>
  {% endfor %}
  {% endfor %}

  <h2>Software versions</h2>
  {% if versions %}
  <table>
    <thead><tr><th>Tool</th><th>Version</th></tr></thead>
    <tbody>
      {% for tool, version in versions.items() %}
      <tr><td>{{ tool }}</td><td>{{ version }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>No versions.yml files were found next to the results.</p>
  {% endif %}
</body>
</html>
