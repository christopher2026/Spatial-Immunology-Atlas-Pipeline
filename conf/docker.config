/*
 * Docker profile: one image per tool, selected by process label.
 *
 * `runOptions = '-u $(id -u):$(id -g)'` makes container processes run as your host user, so files
 * written into the task work directory are owned by you rather than root. Skip this and you get
 * permission errors the first time you try to clean up `work/` - a classic first-week Nextflow bug.
 *
 * `fixOwnership` and `docker.enabled` are the only two settings that are strictly required; the rest
 * are hygiene.
 */

docker {
    enabled      = true
    runOptions   = '-u $(id -u):$(id -g)'
    fixOwnership = true
    // Mount a fresh host temp dir at /tmp per task. Several of these tools (numba's cache, matplotlib's
    // font cache, scrublet's scratch) write to /tmp, and sharing one across concurrent tasks in a
    // read-only-rootfs container is a reliable source of confusing intermittent failures.
    temp         = 'auto'
}

// Only one container runtime may be active at a time.
singularity.enabled = false
conda.enabled       = false

process {
    withLabel: container_scanpy {
        container = "${params.container_prefix}-scanpy:${params.container_tag}"
    }
    withLabel: container_tangram {
        container = "${params.container_prefix}-tangram:${params.container_tag}"
    }
    withLabel: container_report {
        container = "${params.container_prefix}-report:${params.container_tag}"
    }
}
